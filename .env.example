# App
ENVIRONMENT=development
APP_NAME=Pebble Feet Backend
APP_DESCRIPTION=Pebble Feet e-commerce backend API
DEBUG=true
VERSION=1.0.0

# Security / JWT
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (matches docker-compose service "postgres")
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pebblefeet

# Redis (matches docker-compose service "redis")
REDIS_URL=redis://localhost:6379/0


# CORS: comma-separated origins of your website/admin panel, or ["*"] for all
CORS_ORIGINS=http://localhost:3000

# Razorpay (Dashboard -> Account & Settings -> API Keys; use rzp_test_ keys until launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Checkout rules (all optional; these are the defaults). Prices are GST-inclusive.
SHIPPING_FEE=50
FREE_SHIPPING_THRESHOLD=499
COD_ENABLED=true
COD_MAX_ORDER_AMOUNT=5000
MAX_QUANTITY_PER_ITEM=10
PENDING_ORDER_TTL_MINUTES=30
RETURN_WINDOW_DAYS=7

# First admin account: uv run python -m app.scripts.seed_admin
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
